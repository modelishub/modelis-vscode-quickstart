{
  "name": "modelis-quickstart",
  "displayName": "Modelis Quickstart",
  "description": "Drop-in setup helper for the Modelis LLM gateway (~95 models, one key, OpenAI-compatible at modelishub.com/v1) in Cline, Roo Code, Zoo Code, Continue, and Aider.",
  "version": "0.1.1",
  "publisher": "modelishub",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Machine Learning"],
  "keywords": ["cline", "roo code", "zoo code", "continue", "aider", "llm", "openai", "claude", "gemini", "agent"],
  "homepage": "https://modelishub.com",
  "bugs": { "url": "https://github.com/modelishub/modelis-vscode-quickstart/issues" },
  "repository": {
    "type": "git",
    "url": "https://github.com/modelishub/modelis-vscode-quickstart"
  },
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "modelis.setApiKey",
        "title": "Modelis: Set API Key"
      },
      {
        "command": "modelis.showConfig",
        "title": "Modelis: Show Provider Config for My Tool"
      },
      {
        "command": "modelis.writeContinueConfig",
        "title": "Modelis: Add to Continue Config (~/.continue/config.yaml)"
      }
    ]
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.24.0"
  }
}
